---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import headshot from '../assets/headshot.png';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mustafa Hasnain',
  url: 'https://mustafahasnain.com',
  jobTitle: 'Server Repair Technician',
  description: 'IT student and server repair technician in the Dallas–Fort Worth area, working toward a career in IT infrastructure and networking.',
  address: { '@type': 'PostalAddress', addressRegion: 'TX', addressCountry: 'US' },
  knowsAbout: ['Active Directory', 'Microsoft Entra ID', 'Linux', 'Networking', 'Cisco', 'Troubleshooting'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Texas at Dallas',
  },
  sameAs: [
    'https://github.com/MustafaHas9',
    'https://www.linkedin.com/in/mustafahas9/',
    'https://www.youtube.com/@Mustafa.Has9',
  ],
};
---

<Layout
  title="Mustafa Hasnain | IT Support, Help Desk & Networking | DFW"
  description="Mustafa Hasnain is an IT student and server repair technician in Dallas–Fort Worth. Home labs in Active Directory, Entra ID, Linux, and networking."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  <section class="page hero">
    <div class="headshot">
      <Image
        src={headshot}
        alt="Portrait of Mustafa Hasnain"
        width={400}
        height={400}
        fit="cover"
        position="top"
        format="webp"
        loading="eager"
      />
    </div>
    <h1>Mustafa Hasnain</h1>
    <p class="subhead">
      IT Student | Server Repair Technician
    </p>

    <div class="story">
      <p>
        I'm studying Computer Information Systems and Technology at UT Dallas and currently work as a server
        repair technician, where I test and troubleshoot data center GPUs.
      </p>
      <p>
        Outside of work and school, I spend a lot of time working on my home lab. I've built an Active
        Directory environment, connected it to Microsoft Entra ID, and worked on various Linux and networking
        projects.
      </p>
      <p>
        I enjoy figuring out how things work, especially when something breaks and I have to troubleshoot it.
        I've learned a lot from those experiences, and I try to document what I build along the way.
      </p>
      <p>
        I'm working toward a career in IT infrastructure and networking. This site is where I share my
        projects, certifications, and experience.
      </p>
    </div>

    <div class="cta-row">
      <Button href="/projects" variant="gold">
        See the projects <span aria-hidden="true">&rarr;</span>
      </Button>
      <Button href="/qualifications" variant="secondary">
        Qualifications <span aria-hidden="true">&rarr;</span>
      </Button>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
  }

  /* Round frame with a soft gold halo, to match the glow used on buttons and headings. */
  .headshot {
    width: 200px;
    height: 200px;
    margin: 0 auto var(--space-lg);
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 30%, rgb(var(--accent-rgb) / 0.28), transparent 70%), var(--color-bg-secondary);
    box-shadow: 0 0 0 2px rgb(var(--accent-rgb) / 0.7), 0 0 28px rgb(var(--accent-rgb) / 0.35);
  }

  .headshot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }

  .subhead {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 38rem;
    margin: 0 auto var(--space-xl);
  }

  .story {
    max-width: 34rem;
    margin: 0 auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .story p {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .cta-row {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
