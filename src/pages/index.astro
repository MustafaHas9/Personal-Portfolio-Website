---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { TextureButton } from '@/components/ui/texture-button';
import headshot from '../assets/headshot.png';
---

<Layout title="Mustafa Hasnain">
  <section class="page hero">
    <div class="headshot">
      <Image
        src={headshot}
        alt="Portrait of Mustafa Hasnain"
        width={400}
        height={400}
        fit="cover"
        position="top"
        format="webp"
        loading="eager"
      />
    </div>
    <h1>Mustafa Hasnain</h1>
    <p class="subhead">
      I like understanding how networks and systems actually work — then proving it by building the thing myself.
    </p>

    <div class="story">
      <p>
        I'm a Computer Information Systems and Technology student at UT Dallas, and most of what I know about
        networking and infrastructure I've learned by building it rather than reading about it.
      </p>
      <p>
        That's led to a home lab running Active Directory across four virtual machines — a domain controller, a
        routing server, a file server, and a client — plus a Raspberry Pi that watches over all of it, catching
        outages and confirming recoveries in real time.
      </p>
      <p>
        Right now I'm studying for the CompTIA Network+ certification and looking to start my career in IT and
        networking. The projects and qualifications pages have the specifics.
      </p>
    </div>

    <div class="cta-row">
      <TextureButton href="/projects" variant="gold" size="lg" className="w-auto">
        See the projects <span aria-hidden="true">&rarr;</span>
      </TextureButton>
      <TextureButton href="/qualifications" variant="secondary" size="lg" className="w-auto">
        Qualifications <span aria-hidden="true">&rarr;</span>
      </TextureButton>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
  }

  /* Round frame with a soft gold halo, to match the glow used on buttons and headings. */
  .headshot {
    width: 200px;
    height: 200px;
    margin: 0 auto var(--space-lg);
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 30%, rgb(var(--accent-rgb) / 0.28), transparent 70%), var(--color-bg-secondary);
    box-shadow: 0 0 0 2px rgb(var(--accent-rgb) / 0.7), 0 0 28px rgb(var(--accent-rgb) / 0.35);
  }

  .headshot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }

  .subhead {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 38rem;
    margin: 0 auto var(--space-xl);
  }

  .story {
    max-width: 34rem;
    margin: 0 auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .story p {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .cta-row {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
