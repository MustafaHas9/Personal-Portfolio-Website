---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import headshot from '../assets/headshot.png';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mustafa Hasnain',
  url: 'https://mustafahasnain.com',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Texas at Dallas',
  },
  sameAs: [
    'https://github.com/MustafaHas9',
    'https://www.linkedin.com/in/mustafahas9/',
    'https://www.youtube.com/@Mustafa.Has9',
  ],
};
---

<Layout
  title="Mustafa Hasnain"
  description="Home lab builder and CIS student documenting real networking and systems projects: Active Directory, DNS/DHCP, and network monitoring."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  <section class="page hero">
    <div class="headshot">
      <Image
        src={headshot}
        alt="Portrait of Mustafa Hasnain"
        width={400}
        height={400}
        fit="cover"
        position="top"
        format="webp"
        loading="eager"
      />
    </div>
    <h1>Mustafa Hasnain</h1>
    <p class="subhead">
      I build networks and systems to understand how they actually work.
    </p>

    <div class="story">
      <p>
        I'm a Computer Information Systems and Technology student at UT Dallas, and most of what I know about
        networking and infrastructure came from building things myself instead of just reading about them.
      </p>
      <p>
        That turned into a home lab running Active Directory across four VMs (a domain controller, a routing
        server, a file server, and a client), plus a Raspberry Pi that keeps an eye on all of it and tells me
        when something goes down.
      </p>
      <p>
        I recently got my CompTIA Network+ and I'm looking to start my career in IT and networking. The
        projects and qualifications pages have the details.
      </p>
    </div>

    <div class="cta-row">
      <Button href="/projects" variant="gold">
        See the projects <span aria-hidden="true">&rarr;</span>
      </Button>
      <Button href="/qualifications" variant="secondary">
        Qualifications <span aria-hidden="true">&rarr;</span>
      </Button>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
  }

  /* Round frame with a soft gold halo, to match the glow used on buttons and headings. */
  .headshot {
    width: 200px;
    height: 200px;
    margin: 0 auto var(--space-lg);
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 30%, rgb(var(--accent-rgb) / 0.28), transparent 70%), var(--color-bg-secondary);
    box-shadow: 0 0 0 2px rgb(var(--accent-rgb) / 0.7), 0 0 28px rgb(var(--accent-rgb) / 0.35);
  }

  .headshot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }

  .subhead {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 38rem;
    margin: 0 auto var(--space-xl);
  }

  .story {
    max-width: 34rem;
    margin: 0 auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .story p {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .cta-row {
    margin-top: var(--space-xl);
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
</style>
