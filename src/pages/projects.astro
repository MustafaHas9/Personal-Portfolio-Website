---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import { filterGroups } from '../data/filter-groups';

const entries = await getCollection('projects');
const projects = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    Content: (await render(entry)).Content,
  }))
);

// A tag filters under its group (see filter-groups.ts), or under its own name if it has none.
// Cards still list their specific tags.
const filterFor = (tag: string) =>
  Object.entries(filterGroups).find(([, tags]) => tags.includes(tag))?.[0] ?? tag;
const filtersOf = (tags: string[]) => [...new Set(tags.map(filterFor))];
const allFilters = [...new Set(projects.flatMap((project) => filtersOf(project.tags)))];
---

<Layout
  title="Projects | Mustafa Hasnain"
  description="Home lab and infrastructure projects: Active Directory and Raspberry Pi monitoring and services."
>
  <section class="page">
    <h1>Projects</h1>

    <div class="filter-wrap">
      <button type="button" id="filter-toggle" class="pill glow-btn" aria-expanded="false" aria-controls="filter-panel">
        Filter by skill
        <Icon name="chevron" size={14} class="chevron" />
      </button>
      <div class="filters" id="filter-panel" role="group" aria-label="Filter by skill" hidden>
        {allFilters.map((filter) => (
          <button type="button" class="chip glow-btn" data-filter={filter} aria-pressed="false">{filter}</button>
        ))}
      </div>
    </div>

    <div class="projects">
      {projects.map((project) => (
        <details class="project" data-filters={JSON.stringify(filtersOf(project.tags))}>
          <summary>
            <div class="card-header">
              <h2>{project.name}</h2>
              <div class="header-actions">
                {project.github && (
                  <a class="github-badge glow-btn" href={project.github} target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                    </svg>
                    <span>GitHub</span>
                  </a>
                )}
                <Icon name="chevron" size={18} class="chevron" />
              </div>
            </div>
            <p class="description">{project.description}</p>
            <div class="tags">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            {project.links.length > 0 && (
              <div class="links">
                {project.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} &rarr;</a>
                ))}
              </div>
            )}
          </summary>

          <div class="expanded">
            {project.images.length > 0 && (
              <div class="photos">
                {project.images.map((img) => (
                  <>
                    <button type="button" class="photo" aria-label={`Enlarge ${project.name} image`}>
                      <Image
                        src={img}
                        alt={project.name}
                        width={960}
                        widths={[480, 960, 1400]}
                        sizes="(max-width: 640px) 90vw, 900px"
                      />
                    </button>
                    <dialog class="lightbox" aria-label={project.name}>
                      <form method="dialog">
                        <button class="lightbox-close glow-btn" aria-label="Close image">&times;</button>
                      </form>
                      <Image src={img} alt={project.name} width={1400} loading="lazy" />
                    </dialog>
                  </>
                ))}
              </div>
            )}
            <div class="story">
              <project.Content />
            </div>
          </div>
        </details>
      ))}
    </div>

    <div class="next-up">
      <p>
        <strong>Coming next:</strong> an interactive Cisco-style CLI trainer built right into this site. Watch
        the badge in the nav bar.
      </p>
    </div>
  </section>
</Layout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLElement>('.project');
  const selected = new Set<string>();

  function applyFilter() {
    cards.forEach((card) => {
      const filters: string[] = JSON.parse(card.dataset.filters || '[]');
      card.hidden = selected.size > 0 && !filters.some((filter) => selected.has(filter));
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter as string;
      const isSelected = selected.has(filter);
      isSelected ? selected.delete(filter) : selected.add(filter);
      chip.setAttribute('aria-pressed', String(!isSelected));
      applyFilter();
    });
  });

  // Native <dialog> gives the focus trap, Escape-to-close and backdrop for free; the only
  // script needed is opening it and closing on a click outside the image.
  document.querySelectorAll<HTMLButtonElement>('.photo').forEach((photo) => {
    const dialog = photo.nextElementSibling as HTMLDialogElement;
    photo.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });

  const filterToggle = document.getElementById('filter-toggle') as HTMLButtonElement;
  const filterPanel = document.getElementById('filter-panel') as HTMLDivElement;

  function closePanel() {
    filterPanel.hidden = true;
    filterToggle.setAttribute('aria-expanded', 'false');
  }

  filterToggle.addEventListener('click', () => {
    const isOpen = !filterPanel.hidden;
    filterPanel.hidden = isOpen;
    filterToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (event) => {
    if (!filterPanel.hidden && !event.composedPath().includes(filterToggle) && !event.composedPath().includes(filterPanel)) {
      closePanel();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !filterPanel.hidden) {
      closePanel();
      filterToggle.focus();
    }
  });
</script>

<style>
  .filter-wrap {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-lg);
  }

  /* Boxy, badge-style control (same 6px radius as .chip/.github-badge/.resume) —
     see the design-philosophy note in CLAUDE.md: squared-off over fully rounded. */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.5rem 1rem;
    border-radius: 9px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .pill:hover,
  .pill:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .pill .chevron {
    transition: transform 0.2s ease;
  }

  .pill[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  /* Dropdown panel anchored under the pill. The [hidden] rule has to come after
     the base rule so it wins over `display: flex` below with equal specificity. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    position: absolute;
    top: calc(100% + var(--space-xs));
    left: 0;
    z-index: 5;
    width: max-content;
    max-width: min(90vw, 28rem);
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: var(--color-bg);
    box-shadow: 0 8px 24px rgb(15 23 42 / 0.16);
  }

  .filters[hidden] {
    display: none;
  }

  .chip {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .chip:hover {
    color: var(--color-text);
  }

  .chip[aria-pressed='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-bg);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: var(--space-lg);
    interpolate-size: allow-keywords;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  /* Open card grows slightly and lifts, so the click reads as the card itself
     expanding. Scale is small enough to stay inside the page gutter at 375px. */
  .project[open] {
    transform: scale(1.015);
    border-color: var(--color-accent);
    box-shadow: 0 10px 30px rgb(var(--accent-rgb) / 0.18);
  }

  /* Native <details> snaps open; animating the content slot's height is the only
     way to ease it without JS. Browsers without ::details-content (Firefox) just
     skip this and still open instantly, so nothing breaks. */
  .project::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
  }

  .project[open]::details-content {
    block-size: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .project,
    .project::details-content {
      transition: none;
    }

    .project[open] {
      transform: none;
    }
  }

  .project summary {
    cursor: pointer;
    list-style: none;
  }

  .project summary::-webkit-details-marker {
    display: none;
  }

  /* Cards have optional rows (e.g. no links). Dropping the last row's bottom margin
     keeps the space under the content the same on every card. */
  .project summary > :last-child {
    margin-bottom: 0;
  }

  /* Wraps so the GitHub badge drops under the title on narrow screens instead of
     squeezing the title into a few characters per line. */
  .card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .project h2 {
    font-size: 1.4rem;
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  /* Rotates to point up when the card is open — the only visual cue besides the
     content itself that this is an expandable control, not just a static card. */
  .chevron {
    color: var(--color-text-secondary);
    transition: transform 0.2s ease;
  }

  .project[open] .chevron {
    transform: rotate(180deg);
  }

  .github-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .github-badge:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .description {
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.65;
    margin-bottom: var(--space-md);
  }

  .tags {
    margin-bottom: var(--space-md);
  }

  .tag {
    color: var(--color-text-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem var(--space-md);
  }

  .links a {
    display: inline-block;
    padding: 0.25rem 0;
    font-weight: 600;
    font-size: 0.95rem;
    text-shadow: var(--text-glow-gold);
  }

  .expanded {
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .photos :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .photo {
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .photo:hover,
  .photo:focus-visible {
    border-color: var(--color-accent);
  }

  /* The dialog is the sizing box (not the image) so a tall or wide image can never
     push the close button off screen. */
  .lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: var(--space-sm);
    max-width: min(95vw, 1400px);
    max-height: 95vh;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg);
    overflow: auto;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  .lightbox :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .lightbox-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    width: 2.25rem;
    height: 2.25rem;
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    cursor: pointer;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .story {
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .story :global(p) {
    margin-bottom: var(--space-md);
  }

  .story :global(p:last-child) {
    margin-bottom: 0;
  }

  .next-up {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    border: 1px dashed var(--color-border);
    border-radius: 10px;
    text-align: center;
  }

  .next-up p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .next-up strong {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .project {
      padding: var(--space-md);
    }
  }
</style>
