---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Active Directory Home Lab',
    description:
      "A four-VM Windows Server 2025 environment in VirtualBox simulating a small enterprise network: a domain controller running AD DS, DNS, and DHCP; a routing server handling NAT; a file server with role-based SMB shares; and a domain-joined Windows 11 client. Organizational units, security groups, and Group Policy handle everything from drive mapping to Control Panel restrictions — the same way it'd be structured in a real small business.",
    tags: ['Windows Server 2025', 'Active Directory', 'DNS / DHCP', 'Group Policy', 'RRAS / NAT', 'VirtualBox'],
    github: 'https://github.com/MustafaHas9/Active-Directory-Home-Lab',
    links: [
      { label: 'Walkthrough Part 1', href: 'https://www.youtube.com/watch?v=1mkJi7Ar-DA' },
      { label: 'Walkthrough Part 2', href: 'https://www.youtube.com/watch?v=neriTCaLLzA' },
    ],
  },
  {
    name: 'Raspberry Pi Network Monitoring Server',
    description:
      "A Raspberry Pi running Debian and Docker keeps watch over the home lab, using Uptime Kuma to monitor eight systems and services — from internet connectivity and DNS resolution to the domain controller and file server. It reaches the isolated VirtualBox network through a static route across the lab's RRAS server, and it's already caught and logged a real outage during testing.",
    tags: ['Raspberry Pi', 'Debian 13', 'Docker', 'Uptime Kuma', 'Static Routing'],
    github: 'https://github.com/MustafaHas9/Raspberry-Pi-Network-Monitoring-Server',
    links: [],
  },
];
---

<Layout title="Projects | Mustafa Hasnain">
  <section class="page">
    <h1>Projects</h1>

    <div class="projects">
      {projects.map((project) => (
        <article class="project">
          <div class="card-header">
            <h2>{project.name}</h2>
            <a class="github-badge glow-btn" href={project.github} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </div>
          <p class="description">{project.description}</p>
          <div class="tags">
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          {project.links.length > 0 && (
            <div class="links">
              {project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} &rarr;</a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="next-up">
      <p>
        <strong>Coming next:</strong> an interactive Cisco-style CLI simulator built directly into this site —
        watch the badge in the nav bar.
      </p>
    </div>
  </section>
</Layout>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: var(--space-lg);
  }

  /* Cards have optional rows (e.g. no links). Dropping the last row's bottom margin
     keeps the space under the content the same on every card. */
  .project > :last-child {
    margin-bottom: 0;
  }

  /* Wraps so the GitHub badge drops under the title on narrow screens instead of
     squeezing the title into a few characters per line. */
  .card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .project h2 {
    font-size: 1.4rem;
    color: var(--color-accent);
  }

  .github-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 0.875rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .github-badge:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .description {
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.65;
    margin-bottom: var(--space-md);
  }

  .tags {
    margin-bottom: var(--space-md);
  }

  .tag {
    color: var(--color-text-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem var(--space-md);
  }

  .links a {
    font-weight: 600;
    font-size: 0.95rem;
    text-shadow: var(--text-glow-gold);
  }

  .next-up {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    border: 1px dashed var(--color-border);
    border-radius: 10px;
    text-align: center;
  }

  .next-up p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .next-up strong {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .project {
      padding: var(--space-md);
    }
  }
</style>
