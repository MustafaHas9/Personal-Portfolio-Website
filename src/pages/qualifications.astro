---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const coursework = [
  'Intro to Networking',
  'IT Essentials',
  'Intro to Programming',
  'Intro to Script Languages',
  'IT for Business',
];

// `status` picks the pill style: 'done' is the filled gold pill, 'upcoming' is the greyed-out one.
// No status means no pill. `badge` is the official issuer badge, shown unaltered: only add one
// for a certification that has actually been earned.
const certifications = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
const skillGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Qualifications | Mustafa Hasnain"
  description="Education, certifications, and skills: CompTIA Network+, Google IT Support Professional, and a B.S. in Computer Information Systems and Technology."
>
  <section class="page">
    <h1>Qualifications</h1>

    <section class="block">
      <h2>Education</h2>
      <div class="edu">
        <h3>B.S. in Computer Information Systems and Technology</h3>
        <p class="school">University of Texas at Dallas</p>
        <p class="meta">Expected May 2028</p>
        <div class="coursework">
          <h4>Coursework</h4>
          <p>{coursework.join(' · ')}</p>
        </div>
      </div>
    </section>

    <section class="block">
      <h2>Certifications</h2>
      <ul class="certs">
        {certifications.map(({ data: cert }) => (
          <li class:list={{ upcoming: cert.status === 'upcoming' }}>
            {cert.credlyUrl && (
              <a
                class="card-link"
                href={cert.credlyUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Verify ${cert.name} on Credly`}
              ></a>
            )}
            <div class="cert-text">
              <span class="cert-name">{cert.name}</span>
              {cert.status && <span class={`status status-${cert.status}`}>{cert.label}</span>}
            </div>
            {cert.badge && (
              <div class="badge">
                <Image src={cert.badge.src} alt={cert.badge.alt} width={144} format="png" />
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2>Skills</h2>

      <div class="skill-groups">
        {skillGroups.map(({ data: group }) => (
          <div class="skill-group">
            <h3>{group.group}</h3>
            <div class="tags">
              {group.items.map((skill) => <span class="tag">{skill}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>
  </section>
</Layout>

<style>
  /* Space goes between blocks, not above the first one, so the page title sits the
     same distance from the first block as it does on the other pages. */
  .block + .block {
    margin-top: var(--space-2xl);
  }

  .block h2 {
    font-size: 1.6rem;
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }

  .edu h3 {
    margin-bottom: var(--space-xs);
    font-size: 1.3rem;
  }

  .school {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .meta {
    color: var(--color-text-secondary);
  }

  .coursework {
    margin-top: var(--space-md);
  }

  .coursework h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
    font-weight: 600;
  }

  .coursework p {
    color: var(--color-text-secondary);
    font-size: 1.02rem;
  }

  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 19rem min keeps room for the badge plus a two-line name; min(..., 100%) stops a
       single column from overflowing on very narrow phones. */
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    /* Every row is as tall as the tallest card, so all cards match even when they
       wrap onto separate rows (tablet, phone) or only some have a pill. */
    grid-auto-rows: 1fr;
    gap: var(--space-sm);
  }

  /* Text on the left, optional badge on the right. Text always starts at the same left
     edge, so cards line up whether or not they have a badge. */
  .certs li {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: border-color 0.2s ease;
  }

  /* Stretched-link pattern: this covers the whole card so the entire thing is
     clickable, not just the cert name. */
  .card-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transition: box-shadow 0.2s ease;
  }

  /* Mouse hover only: a plain border highlight that clears the moment the
     cursor leaves — kept separate from :focus below so it doesn't linger. */
  .certs li:has(.card-link:hover) {
    border-color: var(--color-accent);
  }

  /* Plain :focus (not :focus-visible): fires for a mouse click too, since
     clicking through to Credly and tabbing back is the main case. Browsers
     don't clear focus just because you click a non-interactive part of the
     page afterward, so a plain `box-shadow: ...` here would get stuck exactly
     like the border did — a one-shot fade-out animation clears itself on a
     timer instead of depending on focus actually being released. */
  .card-link:focus {
    animation: card-glow-fade 1.4s ease forwards;
  }

  @keyframes card-glow-fade {
    from {
      box-shadow: 0 0 22px 2px rgb(var(--accent-rgb) / 0.6);
    }
    to {
      box-shadow: 0 0 22px 2px rgb(var(--accent-rgb) / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link:focus {
      animation: none;
    }
  }

  .cert-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  /* Issuer badges must not be distorted, recoloured, or built into another shape:
     fixed width, height follows the image's own proportions, no effects. */
  .badge {
    flex-shrink: 0;
  }

  .badge :global(img) {
    display: block;
    width: 72px;
    height: auto;
  }

  .cert-name {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .status {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  /* Same 1px border as .status-upcoming so both pills are the same height. */
  .status-done {
    background: var(--color-accent-solid);
    border: 1px solid var(--color-accent-solid);
    color: #ffffff;
  }

  /* Greyed out: not earned yet. The whole entry is muted, not just the pill. */
  .status-upcoming {
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
  }

  .upcoming .cert-name {
    color: var(--color-text-secondary);
  }

  .skill-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-lg);
  }

  .skill-group h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-sm);
  }
</style>
