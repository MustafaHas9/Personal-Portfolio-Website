---
// Plain CSS replacement for Cult UI's TextureButton (see docs/ROADMAP.md, phase 0, item 1) —
// only the variants and sizes this site actually uses.
interface Props {
  variant: 'gold' | 'secondary' | 'icon';
  href?: string;
  id?: string;
  class?: string;
  'aria-label'?: string;
  'aria-pressed'?: 'true' | 'false';
}

const { variant, href, id, class: className, ...rest } = Astro.props;
const size = variant === 'icon' ? 'icon' : 'lg';
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  id={id}
  type={href ? undefined : 'button'}
  class:list={['btn', variant === 'gold' ? 'gold-flow' : 'glow-btn', `btn-${variant}`, `btn-${size}`, className]}
  {...rest}
><slot /></Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid var(--color-border);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease, scale 0.15s ease;
  }

  .btn-lg {
    border-radius: 12px;
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
  }

  .btn-icon {
    border-radius: 50%;
    padding: 0.5rem;
  }

  /* Colour and animation come from .gold-flow (global.css), shared with the nav's
     Coming Soon badge. No glow at rest; hover and keyboard focus use the same glow as
     .glow-btn, so this button matches the secondary one next to it. The text colour is
     restated on hover because the global `a:hover` rule would otherwise turn it gold. */
  .btn-gold {
    border-color: rgb(0 0 0 / 0.15);
    font-weight: 800;
    box-shadow: none;
    transition: box-shadow 0.3s ease, scale 0.15s ease;
  }

  .btn-gold:hover,
  .btn-gold:focus-visible {
    color: var(--gold-ink);
    box-shadow: 0 0 22px 2px var(--glow-hover);
  }

  .btn-secondary,
  .btn-icon {
    background: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .btn-secondary:hover,
  .btn-icon:hover {
    background: var(--color-border);
  }
</style>
