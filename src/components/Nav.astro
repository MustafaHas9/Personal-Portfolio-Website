---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/qualifications', label: 'Qualifications' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <a href="/" class="logo">Mustafa Hasnain</a>
  <nav>
    <ul>
      {links.map((link) => (
        <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="nav-actions">
    <span class="coming-soon" title="Interactive Cisco CLI simulator — coming soon">Coming Soon</span>
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
      <span id="theme-toggle-icon">🌙</span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .logo {
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--color-text);
    white-space: nowrap;
    justify-self: start;
  }

  nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  nav a {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  nav a:hover {
    color: var(--color-accent);
  }

  nav a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 600;
  }

  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .coming-soon {
    background: var(--color-accent-solid);
    color: #ffffff;
    border-radius: 8px;
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  #theme-toggle {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    cursor: pointer;
    padding: 0.55rem 0.75rem;
    font-size: 1.15rem;
    line-height: 1;
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-toggle-icon');

  function setIcon(theme: string) {
    if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
  }

  setIcon(document.documentElement.getAttribute('data-theme') || 'light');

  toggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    setIcon(next);
  });
</script>
