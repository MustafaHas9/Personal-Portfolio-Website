---
import Icon from './Icon.astro';
import Button from './Button.astro';

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/qualifications', label: 'Qualifications' },
];

// `brand` picks the glow colour (see .social[data-brand] below).
const socials: { label: string; href: string; icon: 'github' | 'linkedin' | 'youtube' | 'envelope'; brand: string; external?: boolean }[] = [
  { label: 'GitHub', href: 'https://github.com/MustafaHas9', icon: 'github', brand: 'github', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mustafahas9/', icon: 'linkedin', brand: 'linkedin', external: true },
  { label: 'YouTube', href: 'https://www.youtube.com/@Mustafa.Has9', icon: 'youtube', brand: 'youtube', external: true },
  { label: 'Email', href: 'mailto:mustafahasnain006@gmail.com', icon: 'envelope', brand: 'gold' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav">
  <a href="/" class="logo">mustafahasnain<span class="tld">.com</span></a>
  <nav>
    <ul>
      {links.map((link) => (
        <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>
      ))}
      <li>
        <a class="learn-link gold-flow" href="/learn" aria-current={currentPath.startsWith('/learn') ? 'page' : undefined}>Learn</a>
      </li>
    </ul>
  </nav>
  <div class="nav-actions">
    <a class="resume glow-btn" href="/Mustafa-Hasnain-Resume.pdf" download title="Download resume (PDF)">Resume</a>
    {socials.map(({ icon, label, href, brand, external }) => (
      <a
        class="social"
        data-brand={brand}
        href={href}
        aria-label={label}
        title={label}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
      >
        <Icon name={icon} size={22} />
      </a>
    ))}
    <Button id="theme-toggle" variant="icon" aria-label="Toggle dark mode" aria-pressed="false">
      <Icon name="moon" size={16} class="icon-moon" />
      <Icon name="sun" size={16} class="icon-sun" />
    </Button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    /* minmax(0, 1fr) forces the two side columns to be exactly equal whatever they contain,
       so the links in the middle stay centred on the page even if icons are added later. */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'logo nav actions';
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);

    /* Gold hover glow for the logo and text links: a tight bright layer plus a wide soft one. */
    --nav-hover-glow: 0 0 8px rgb(var(--accent-rgb) / 0.9), 0 0 22px rgb(var(--accent-rgb) / 0.6);
  }

  .logo {
    grid-area: logo;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--color-text);
    white-space: nowrap;
    justify-self: start;
    transition: text-shadow 0.3s ease, scale 0.15s ease;
  }

  .nav > nav {
    grid-area: nav;
  }

  .logo:hover,
  .logo:focus-visible {
    text-shadow: var(--nav-hover-glow);
  }

  .tld {
    color: var(--color-accent);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 0.75rem var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* inline-block because `scale` has no effect on inline boxes, and the links need it
     for the same press-in as the buttons (see the :active rule below). */
  nav a {
    display: inline-block;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    transition: color 0.2s ease, text-shadow 0.3s ease, scale 0.15s ease;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent);
    text-shadow: var(--nav-hover-glow);
  }

  nav a:active,
  .logo:active {
    scale: 0.94;
  }

  @media (prefers-reduced-motion: reduce) {
    nav a:active,
    .logo:active {
      scale: 1;
    }
  }

  nav a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* The flowing gold look comes from .gold-flow in global.css (shared with the gold
     Button); only the badge's own shape and type are set here. The selector includes
     `nav a` so it beats the generic nav link colour, size, hover, and weight above. */
  nav a.learn-link {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.2rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--gold-ink);
    text-shadow: none;
    transition: box-shadow 0.3s ease, scale 0.15s ease;
  }

  nav a.learn-link:hover,
  nav a.learn-link:focus-visible {
    color: var(--gold-ink);
    text-shadow: none;
    box-shadow: 0 0 22px 2px var(--glow-hover);
  }

  .nav-actions {
    grid-area: actions;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* Same small-badge look as the GitHub link on the projects page. */
  .resume {
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .resume:hover,
  .resume:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Standalone logos: no circle, glow follows the logo's own shape. */
  /* The glow colour is bare RGB channels so both filter states are plain rgb() colours
     and always have the same number of drop-shadows. Mixing colour spaces or list
     lengths here made the browser interpolate through a bright gold on hover. */
  .social {
    --glow-rgb: var(--accent-rgb);
    display: inline-flex;
    color: var(--color-text);
    filter: drop-shadow(0 0 4px rgb(var(--glow-rgb) / 0.35)) drop-shadow(0 0 0 rgb(var(--glow-rgb) / 0));
    transition: filter 0.3s ease, transform 0.2s ease, scale 0.15s ease;
  }

  .social:hover,
  .social:focus-visible {
    filter: drop-shadow(0 0 5px rgb(var(--glow-rgb) / 1)) drop-shadow(0 0 14px rgb(var(--glow-rgb) / 1));
    transform: scale(1.12);
  }

  .social[data-brand='github'] {
    --glow-rgb: 255 255 255;
  }

  .social[data-brand='linkedin'] {
    --glow-rgb: 26 134 240;
  }

  .social[data-brand='youtube'] {
    --glow-rgb: 255 32 32;
  }

  /* White would vanish on the light theme, so GitHub falls back to a dark glow there. */
  :global([data-theme='light']) .social[data-brand='github'] {
    --glow-rgb: 36 41 47;
  }

  /* Theme toggle shows one icon at a time: moon when the site is light (click to go
     dark), sun when it's dark (click to go light). */
  #theme-toggle :global(.icon-sun) {
    display: none;
  }

  :global([data-theme='dark']) #theme-toggle :global(.icon-sun) {
    display: block;
  }

  :global([data-theme='dark']) #theme-toggle :global(.icon-moon) {
    display: none;
  }

  /* The single-row layout needs about 900px (logo + links + 4 icons + toggle), so below
     that the links move to their own row under the logo and icons. */
  @media (max-width: 899px) {
    .nav {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo actions'
        'nav nav';
      row-gap: 0.75rem;
    }
  }

  /* Phones: everything stacks and centres, and the links row is tightened so
     "Projects / Qualifications / Coming Soon" fit on one line. */
  @media (max-width: 499px) {
    .nav {
      grid-template-columns: 1fr;
      grid-template-areas:
        'logo'
        'nav'
        'actions';
      justify-items: center;
    }

    .logo,
    .nav-actions {
      justify-self: center;
    }

    nav ul {
      gap: 0.75rem var(--space-sm);
    }

    nav a {
      font-size: 1rem;
    }

    nav a.learn-link {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      letter-spacing: 0.06em;
    }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');

  function setPressed(theme: string) {
    toggle?.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
  }

  setPressed(document.documentElement.getAttribute('data-theme') || 'light');

  toggle?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    setPressed(next);
  });
</script>
